# ============================================
# VGNC Download File Generator Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
# MySQL database host
APP_DATABASE__DBHOST=localhost

# MySQL database username
APP_DATABASE__DBUSER=your_username

# MySQL database password
APP_DATABASE__DBPASS=your_password

# MySQL database port (default: 3306)
APP_DATABASE__DBPORT=3306

# MySQL database name
APP_DATABASE__DBNAME=vgnc

# ============================================
# Google Cloud Storage Configuration
# ============================================
# GCS bucket name for file uploads
APP_GCS__BUCKET_NAME=your-gcs-bucket-name

# Google Cloud project ID
APP_GCS__PROJECT_ID=your-project-id

# ============================================
# Runtime Configuration (Optional)
# ============================================
# Chunk size for database streaming (default: 5000)
# Larger values use more memory but may be faster
APP_RUNTIME__CHUNK_SIZE=5000

# Maximum parallel workers (default: 4)
# Number of concurrent file generation processes
APP_RUNTIME__MAX_WORKERS=4

# ============================================
# GCP Authentication (Optional)
# ============================================
# Path to service account key file for GCS authentication
# If not set, will use Application Default Credentials (ADC)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================
# GCP Secret Manager (Optional)
# ============================================
# If using Secret Manager for database credentials,
# the application will fetch credentials from this secret name
# GOOGLE_SECRET_MANAGER_SECRET_NAME=vgnc-db-credentials

# ============================================
# Logging Configuration (Optional)
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: text or json
LOG_FORMAT=text
