# VGNC Download File Generator — Environment Variables
#
# In Cloud Run, these are injected automatically.
# Locally, export them in your shell or use direnv.

# Database
DB_HOST=localhost
DB_USER=your_username
DB_PASSWORD=your_password
DB_PORT=3306
DB_NAME=vgnc_public_2025_01_01

# GCS
GCS_BUCKET=your-gcs-bucket
GCS_PROJECT_ID=your-project-id
GCS_PREFIX=vgnc/

# Runtime (Cloud Run Job overrides)
VGNC_MODE=species
VGNC_SPECIES=9913
VGNC_FORMATS=tsv,json
